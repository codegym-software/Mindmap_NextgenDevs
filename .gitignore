# ==============================
#  Global ignores
# ==============================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.tmp
*.swp

# ==============================
#  Node / React / Vite (web/)
# ==============================
web/node_modules/
web/dist/
web/.vite/
web/.vite-temp/
web/.env
web/.env.*
!web/.env.example
web/.eslintcache

# build cache
web/.parcel-cache/
web/.turbo/

# ==============================
#  Java / Spring Boot (api/)
# ==============================
api/target/
api/.classpath
api/.project
api/.settings/
api/*.iml
api/.mvn/
api/mvnw
api/mvnw.cmd
api/.env
api/.env.*

# ==============================
#  Docker / Infra
# ==============================
infra/mongo-data/
infra/mysql-data/
infra/postgres-data/
infra/redis-data/
infra/nginx/logs/
infra/nginx/cache/
infra/logs/
infra/tmp/
*.pid

# ==============================
#  Environment and secrets
# ==============================
.env
.env.*
!env.example
*.pem
*.key
*.crt

# ==============================
#  OS & Editor junk
# ==============================
*.bak
*.orig
*.rej
*~
